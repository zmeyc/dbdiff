# syntax=docker/dockerfile:1.7

FROM ubuntu:22.04 AS build

ARG TARGET_TRIPLET
ARG VCPKG_COMMIT=c5a15727ee70fddf0296f0d8aafc3f58916fefac

ENV DEBIAN_FRONTEND=noninteractive
ENV VCPKG_DISABLE_METRICS=1
ENV VCPKG_FEATURE_FLAGS=manifests

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      binutils bison build-essential ca-certificates curl file flex git ninja-build perl pkg-config \
      python3-pip sqlite3 tar unzip zip \
    && pip3 install --no-cache-dir cmake==3.31.6 \
    && find /var/lib/apt/lists -mindepth 1 -delete

# Version overrides need historical port trees, so fetch the complete pinned history.
RUN git init /opt/vcpkg \
    && git -C /opt/vcpkg remote add origin https://github.com/microsoft/vcpkg.git \
    && git -C /opt/vcpkg fetch origin "${VCPKG_COMMIT}" \
    && git -C /opt/vcpkg checkout --detach FETCH_HEAD \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics

WORKDIR /src
COPY . .

# Extracted host tools share directory names across architectures.
RUN --mount=type=cache,target=/root/.cache/vcpkg,sharing=locked \
    --mount=type=cache,id=dbdiff-vcpkg-downloads-${TARGET_TRIPLET},target=/opt/vcpkg/downloads,sharing=locked \
    test -n "${TARGET_TRIPLET}" \
    && cmake -S . -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_TESTING=ON \
      -DDBDIFF_BUILD_INTEGRATION_TESTS=ON \
      -DDBDIFF_DISTRIBUTION_BUILD=ON \
      -DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
      -DVCPKG_HOST_TRIPLET="${TARGET_TRIPLET}" \
      -DVCPKG_OVERLAY_TRIPLETS=/src/cmake/triplets \
      -DVCPKG_TARGET_TRIPLET="${TARGET_TRIPLET}" \
    && cmake --build /build --parallel \
    && ctest --test-dir /build --no-tests=error --output-on-failure -L '^unit$' \
    && ctest --test-dir /build --no-tests=error --output-on-failure -L '^integration\.sqlite$' \
    && cmake --install /build --prefix /stage --strip

RUN set -eux; \
    file /stage/bin/dbdiff; \
    if readelf -d /stage/bin/dbdiff \
      | grep -E 'NEEDED.*(libpq|libpqxx|libssl|libcrypto|libsqlite3|libyaml-cpp|libstdc\+\+|libgcc_s)'; then \
      echo "distribution binary has a forbidden dynamic dependency" >&2; \
      exit 1; \
    fi; \
    max_glibc="$(objdump -T /stage/bin/dbdiff \
      | grep -oE 'GLIBC_[0-9.]+' \
      | cut -d_ -f2 \
      | sort -V \
      | tail -1)"; \
    test -n "${max_glibc}"; \
    dpkg --compare-versions "${max_glibc}" le 2.35; \
    test "$(/stage/bin/dbdiff --version)" = "$(python3 -c 'import json; print(json.load(open("/src/package.json"))["version"])')"

FROM scratch AS artifact
COPY --from=build /stage/bin/dbdiff /dbdiff
